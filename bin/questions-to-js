#!/usr/bin/env python3
"""Converts docs/questions-test-du-builder.md into _wip/builder-test/questions.js.

  bin/questions-to-js

The markdown is the source of truth: edit it, then rerun this.
"""

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "docs" / "questions-test-du-builder.md"
OUTPUT = ROOT / "_wip" / "builder-test" / "questions.js"

FACETS = {
    "ce que tu lances": "lance",
    "ce que tu fermes": "closed",
    "ce que tu laisses": "laisse",
}

HEADER = """// Generated by bin/questions-to-js from docs/questions-test-du-builder.md. Do not edit.
"""


def main():
    text = SOURCE.read_text(encoding="utf-8")
    facet = None
    step_section = 0
    questions = []

    # A question starts at `> **`. Text after it, up to the next heading, holds the step note.
    for block in re.finditer(
        r"^(?:# (?P<facet>.+)|## (?P<section>.+)|> \*\*(?P<prompt>.+?)\*\*\n(?P<body>(?:>.*\n)*)(?P<notes>(?:(?!^#|^> ).*\n)*))",
        text,
        flags=re.M,
    ):
        if block.group("facet"):
            name = block.group("facet").removeprefix("Facette : ").strip().lower()
            facet = FACETS.get(name)
            step_section = 0
            continue

        if block.group("section"):
            found = re.search(r"\(étape (\d+)\)", block.group("section"))
            step_section = int(found.group(1)) if found else 0
            continue

        if not facet:
            continue

        body, notes = block.group("body"), block.group("notes") or ""
        options = [
            {"t": t, "v": int(v)}
            for t, v in re.findall(r"^> - (.+?) \*\((\d)\)\*$", body, flags=re.M)
        ]
        type_q = "situation"
        if not options:
            options = [
                {"t": t.strip(), "v": int(v)}
                for t, v in re.findall(r"([^·>\n]+?) \*\((\d)\)\*", body)
            ]
            type_q = "event"
        if len(options) != 4:
            continue  # margin question: no values, not scored

        step = step_section
        note = re.search(r"\*Étape (\d+)", notes)
        if note:
            step = int(note.group(1))
        elif re.search(r"\*Étape : aucune", notes):
            step = 0

        questions.append(
            {
                "facet": facet,
                "step": step,
                "type": type_q,
                "prompt": block.group("prompt").strip(),
                "options": options,
            }
        )

    count = {}
    for q in questions:
        count[q["facet"]] = count.get(q["facet"], 0) + 1
    if len(questions) != 36:
        sys.exit(f"{len(questions)} questions notées trouvées, 36 attendues : {count}")
    for key, n in count.items():
        if n != 12:
            sys.exit(f"La facette {key} porte {n} questions, 12 attendues.")

    margin = [
        {"prompt": e.strip(), "options": [o.strip() for o in o_.split(" · ")]}
        for e, o_ in re.findall(
            r"^> \*\*(.+?)\*\*\n>\n> ([^*\n]+·[^*\n]+)$", text, flags=re.M
        )
    ]
    if len(margin) != 4:
        sys.exit(f"{len(margin)} questions de marge trouvées, 4 attendues.")

    body = json.dumps(questions, ensure_ascii=False, indent=2)
    edge = json.dumps(margin, ensure_ascii=False, indent=2)
    OUTPUT.write_text(
        f"{HEADER}\nwindow.QUESTIONS = {body};\n\nwindow.MARGIN = {edge};\n",
        encoding="utf-8",
    )
    situations = sum(1 for q in questions if q["type"] == "situation")
    print(
        f"{OUTPUT.relative_to(ROOT)} : {len(questions)} questions, "
        f"{situations} situations, {len(questions) - situations} événements, "
        f"{len(margin)} questions de marge, {count}"
    )


if __name__ == "__main__":
    main()
