#!/usr/bin/env node
import assert from "node:assert/strict";
import { readFileSync, readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { join } from "node:path";
import { check } from "./lint.mjs";
const root = fileURLToPath(new URL("..", import.meta.url));
const chapters = readdirSync(join(root, "_chapters")).filter((f) => f.endsWith(".md"));
const sources = chapters.map((filename) => ({ filename, source: readFileSync(join(root, "_chapters", filename), "utf8") }));
const withoutRoles = (source) => source.replace(/## Depuis ton siège\n[\s\S]*?(?=## À discuter)/, "");
const withRoles = (source) => withoutRoles(source).replace("## À discuter", "## Depuis ton siège\n\n- **Finance** : précise le geste.\n\n## À discuter");
let checks = 0;
function test(name, run) { run(); checks++; }
for (const type of ["principle", "diagnostic", "practice", "system"]) {
  const fixture = sources.find(({source}) => source.includes(`card_type: ${type}\n`));
  test(`${type} : le bloc « Depuis ton siège » n'existe plus`, () => {
    assert.deepEqual(check({...fixture,source:withoutRoles(fixture.source)}).rules, []);
    assert(check({...fixture,source:withRoles(fixture.source)}).rules.some((r)=>r.includes('Depuis ton siège')));
  });
}
test('Un bloc essentiel manquant reste signalé',()=> {
  const fixture=sources.find(({source})=>source.includes('card_type: principle\n'));
  assert(check({...fixture,source:fixture.source.replace('## Pourquoi','## Explication libre')}).rules.length > 0);
});
console.log(`Linter valide : ${checks} groupes de vérifications sur les quatre types de cartes.`);
