#!/bin/sh
# Tire le livre en PDF et en EPUB. Sortie : build/build-here.pdf, build/build-here.epub
#
#   bin/build-book        les deux
#   bin/build-book pdf    le PDF seul
#   bin/build-book epub   l'EPUB seul
#
# Jekyll assemble le livre en deux pages HTML (_pdf/book.html et _pdf/epub.html,
# corps commun dans _includes/book-body.html). WeasyPrint pagine la premiere,
# Pandoc empaquette la seconde.
#
#   brew install weasyprint pandoc
set -e
cd "$(dirname "$0")/.."

what="${1:-all}"
out="build"
name="build-here"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "$1 introuvable. brew install $1" >&2; exit 1; }
}

case "$what" in
  pdf)  need weasyprint ;;
  epub) need pandoc ;;
  all)  need weasyprint; need pandoc ;;
  *)    echo "usage: bin/build-book [pdf|epub]" >&2; exit 2 ;;
esac

# Le livre se construit dans son propre dossier. _site reste celui du site :
# le tirage desactive auto_ids (voir _config-pdf.yml) et un _site produit ici
# n'aurait pas les ancres de titre que le site publie doit avoir.
site="$out/site"
mkdir -p "$out"
bundle exec jekyll build --config _config.yml,_config-pdf.yml --destination "$site" --quiet

if [ "$what" = all ] || [ "$what" = pdf ]; then
  weasyprint --presentational-hints "$site/pdf.html" "$out/$name.pdf"
  echo "$out/$name.pdf"
fi

if [ "$what" = all ] || [ "$what" = epub ]; then
  # --split-level=2 : un fichier par partie et par section, les entrees dedans.
  # --toc-depth=3   : la navigation reprend parties > sections > entrees.
  pandoc "$site/epub.html" \
    --from=html \
    --to=epub3 \
    --standalone \
    --metadata-file="$site/epub-metadata.yml" \
    --resource-path="$site" \
    --epub-cover-image="$site/assets/images/couverture.png" \
    --css=assets/stylesheets/epub.css \
    --epub-embed-font=assets/fonts/Merriweather-Regular.ttf \
    --epub-embed-font=assets/fonts/Merriweather-Bold.ttf \
    --epub-embed-font=assets/fonts/Merriweather-Italic.ttf \
    --epub-embed-font=assets/fonts/Merriweather-BoldItalic.ttf \
    --epub-embed-font=assets/fonts/Archivo-Regular.ttf \
    --epub-embed-font=assets/fonts/Archivo-Bold.ttf \
    --split-level=2 \
    --toc-depth=3 \
    --output="$out/$name.epub"
  echo "$out/$name.epub"
fi
