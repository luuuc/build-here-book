#!/bin/sh
# Builds the book as PDF (WeasyPrint) and EPUB (Pandoc) into build/.
#
#   bin/build-book [pdf|epub|all] [fr|en]    default: all fr
#
# Needs: brew install weasyprint pandoc
set -e
cd "$(dirname "$0")/.."

what="${1:-all}"
lang="${2:-fr}"
out="build"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "$1 introuvable. brew install $1" >&2; exit 1; }
}

case "$what" in
  pdf)  need weasyprint ;;
  epub) need pandoc ;;
  all)  need weasyprint; need pandoc ;;
  *)    echo "usage: bin/build-book [pdf|epub|all] [fr|en]" >&2; exit 2 ;;
esac

case "$lang" in
  fr) name="build-here";    cover="couverture.png"; config="_config.yml,_config-pdf.yml" ;;
  en) name="build-here-en"; cover="cover.png";      config="_config.yml,_config-pdf.yml,_config-pdf-en.yml" ;;
  *)  echo "usage: bin/build-book [pdf|epub|all] [fr|en]" >&2; exit 2 ;;
esac

# Not _site: the print config turns off auto_ids, which the public site needs.
site="$out/site-$lang"
mkdir -p "$out"
# BOOK_CONFIG_EXTRA lets CI inject the release version.
bundle exec jekyll build \
  --config "${config}${BOOK_CONFIG_EXTRA:+,$BOOK_CONFIG_EXTRA}" \
  --destination "$site" --quiet

if [ "$what" = all ] || [ "$what" = pdf ]; then
  weasyprint --presentational-hints "$site/pdf.html" "$out/$name.pdf"
  echo "$out/$name.pdf"
fi

if [ "$what" = all ] || [ "$what" = epub ]; then
  pandoc "$site/epub.html" \
    --from=html \
    --to=epub3 \
    --standalone \
    --metadata-file="$site/epub-metadata.yml" \
    --resource-path="$site" \
    --epub-cover-image="$site/book/assets/images/$cover" \
    --css=book/assets/stylesheets/epub.css \
    --epub-embed-font=book/assets/fonts/Merriweather-Regular.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-Bold.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-Italic.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-BoldItalic.ttf \
    --epub-embed-font=book/assets/fonts/Archivo-Regular.ttf \
    --epub-embed-font=book/assets/fonts/Archivo-Bold.ttf \
    --split-level=1 \
    --toc-depth=2 \
    --output="$out/$name.epub"
  echo "$out/$name.epub"
fi
