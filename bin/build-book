#!/bin/sh
# Tire le livre en PDF et en EPUB.
#
#   bin/build-book              les deux, en francais
#   bin/build-book pdf          le PDF seul
#   bin/build-book epub         l'EPUB seul
#   bin/build-book all en       les deux, en anglais
#
# Sortie : build/build-here.pdf et .epub pour le francais, build/build-here-en.*
# pour l'anglais. Le francais garde son nom sans suffixe : les adresses deja
# imprimees dans les tirages precedents continuent de marcher.
#
# Jekyll assemble le livre en deux pages HTML (_pdf/book.html et _pdf/epub.html,
# corps commun dans _includes/book-body.html). WeasyPrint pagine la premiere,
# Pandoc empaquette la seconde.
#
#   brew install weasyprint pandoc
set -e
cd "$(dirname "$0")/.."

what="${1:-all}"
lang="${2:-fr}"
out="build"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "$1 introuvable. brew install $1" >&2; exit 1; }
}

case "$what" in
  pdf)  need weasyprint ;;
  epub) need pandoc ;;
  all)  need weasyprint; need pandoc ;;
  *)    echo "usage: bin/build-book [pdf|epub|all] [fr|en]" >&2; exit 2 ;;
esac

case "$lang" in
  fr) name="build-here";    config="_config.yml,_config-pdf.yml" ;;
  en) name="build-here-en"; config="_config.yml,_config-pdf.yml,_config-pdf-en.yml" ;;
  *)  echo "usage: bin/build-book [pdf|epub|all] [fr|en]" >&2; exit 2 ;;
esac

# Chaque langue a son dossier de travail : deux tirages lances a la suite ne se
# marchent pas dessus. _site reste celui du site : le tirage desactive auto_ids
# (voir _config-pdf.yml) et un _site produit ici n'aurait pas les ancres de
# titre que le site publie doit avoir.
site="$out/site-$lang"
mkdir -p "$out"
# BOOK_CONFIG_EXTRA laisse la CI injecter le numero de version reel, celui du
# tag, pour que le colophon ne montre pas le champ de secours de _config.yml.
bundle exec jekyll build \
  --config "${config}${BOOK_CONFIG_EXTRA:+,$BOOK_CONFIG_EXTRA}" \
  --destination "$site" --quiet

if [ "$what" = all ] || [ "$what" = pdf ]; then
  weasyprint --presentational-hints "$site/pdf.html" "$out/$name.pdf"
  echo "$out/$name.pdf"
fi

if [ "$what" = all ] || [ "$what" = epub ]; then
  # --split-level=1 : un fichier par section, les cartes dedans.
  # --toc-depth=2   : la navigation reprend sections > cartes.
  pandoc "$site/epub.html" \
    --from=html \
    --to=epub3 \
    --standalone \
    --metadata-file="$site/epub-metadata.yml" \
    --resource-path="$site" \
    --epub-cover-image="$site/book/assets/images/couverture.png" \
    --css=book/assets/stylesheets/epub.css \
    --epub-embed-font=book/assets/fonts/Merriweather-Regular.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-Bold.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-Italic.ttf \
    --epub-embed-font=book/assets/fonts/Merriweather-BoldItalic.ttf \
    --epub-embed-font=book/assets/fonts/Archivo-Regular.ttf \
    --epub-embed-font=book/assets/fonts/Archivo-Bold.ttf \
    --split-level=1 \
    --toc-depth=2 \
    --output="$out/$name.epub"
  echo "$out/$name.epub"
fi
