#!/usr/bin/env node
// Verifie le gabarit admin rendu : nonces CSP, syntaxe du module et trois
// sources de donnees. L'interface elle-meme est ensuite couverte au navigateur.

import { pageAdmin } from "../worker/admin.mjs";

const nonce = "nonce-de-verification";
const page = pageAdmin("verification@example.com", nonce);
const script = (page.split(/<script type="module"[^>]*>/)[1] || "").split("</script>")[0];

if (!script.trim()) {
  console.error("Aucun module trouvé dans la page admin.");
  process.exit(1);
}

for (const balise of ["<style", '<script type="module"']) {
  const debut = page.indexOf(balise);
  const tag = page.slice(debut, page.indexOf(">", debut) + 1);
  if (!tag.includes(`nonce="${nonce}"`)) {
    console.error(`La balise ${balise} ne porte pas le nonce.`);
    process.exit(1);
  }
}

for (const chemin of ["/admin/commentaires", "/admin/notes", "/admin/evaluations"]) {
  if (!script.includes(chemin)) {
    console.error(`Le tableau de bord ne charge jamais ${chemin}.`);
    process.exit(1);
  }
}

// Une compilation sans executer le DOM suffit ici : les comportements sont
// petits et les points d'entree sont verifies ci-dessus.
try {
  await import("data:text/javascript;base64," + Buffer.from(script).toString("base64"));
} catch (e) {
  // ReferenceError sur document prouve que le module a ete analyse puis lance.
  if (!(e instanceof ReferenceError) || !String(e.message).includes("document")) {
    console.error(e.stack || String(e));
    process.exit(1);
  }
}

console.log(`La page admin est valide, ${script.split("\n").length} lignes, trois sources.`);
