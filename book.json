---
layout: none
---
{
  "@context": "https://schema.org",
  "@type": "Book",
  "name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "url": {{ site.url | jsonify }},
  "inLanguage": {{ site.book.language | default: 'fr-FR' | jsonify }},
  "datePublished": {{ site.book.published | jsonify }},
  "dateModified": {{ site.book.modified | jsonify }},
  "version": {{ site.book.version | jsonify }},
  "bookFormat": "https://schema.org/EBook",
  "isAccessibleForFree": true,
  "license": {{ site.book.license | jsonify }},
  "copyrightHolder": {
    "@type": "Person",
    "name": {{ site.author.name | jsonify }}
  },
  "author": {
    "@type": "Person",
    "name": {{ site.author.name | jsonify }},
    "url": "https://www.linkedin.com/in/{{ site.author.linkedin }}",
    "sameAs": [
      "https://twitter.com/{{ site.twitter_username }}",
      "https://github.com/{{ site.github_username }}",
      "https://www.linkedin.com/in/{{ site.author.linkedin }}"
    ]
  },
  "publisher": {
    "@type": "Person",
    "name": {{ site.author.name | jsonify }}
  },
  "tableOfContents": [
    {% assign sorted_chapters = site.chapters | sort: "order" %}
    {% for chapter in sorted_chapters %}
    {
      "position": {{ forloop.index }},
      "order": {{ chapter.order }},
      "title": {{ chapter.title | jsonify }},
      "part": {{ chapter.part | jsonify }},
      "cardType": {{ chapter.card_type | jsonify }},
      "url": {{ chapter.url | absolute_url | jsonify }},
      "description": {{ chapter.seo.description | default: chapter.description | jsonify }},
      {% if chapter.metadata.reading_time_in_minutes %}
      "readingTimeMinutes": {{ chapter.metadata.reading_time_in_minutes }},
      {% endif %}
      "categories": {{ chapter.categories | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "parts": [
    {% assign sorted_chapters = site.chapters | sort: "order" %}
    {% assign parts = sorted_chapters | map: "part" | uniq %}
    {% for part in parts %}
    {
      "name": {{ part | jsonify }},
      "chapters": [
        {% assign part_chapters = sorted_chapters | where: "part", part %}
        {% for chapter in part_chapters %}
        {
          "title": {{ chapter.title | jsonify }},
          "url": {{ chapter.url | absolute_url | jsonify }}
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "keywords": [
    "builders",
    "apprentissage",
    "pratiques",
    "équipes",
    "ownership",
    "curiosité",
    "leadership",
    "exécution"
  ],
  "about": [
    {
      "@type": "Thing",
      "name": "Apprentissage par la pratique"
    },
    {
      "@type": "Thing",
      "name": "Amélioration des services et des réalisations"
    },
    {
      "@type": "Thing",
      "name": "Conditions du travail collectif"
    }
  ],
  "audience": {
    "@type": "Audience",
    "audienceType": "Personnes qui veulent commencer à construire, builders expérimentés, personnes développant des équipes et personnes soutenant des builders"
  },
  "genre": "Business",
  "ai": {
    "crawlPermission": "allowed",
    "trainingPermission": "allowed-with-attribution",
    "contentLicense": "CC-BY-SA-4.0",
    "attributionRequired": true,
    "attributionText": {{ site.author.name | prepend: "Build Here, par " | append: " (" | append: site.url | append: ")" | jsonify }}
  }
}
